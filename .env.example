# ==============================================================================
# GTA 6 AI CLIP FACTORY - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with your credentials.
# All external APIs are optional for local offline clipping; cloud features activate
# automatically when corresponding keys are supplied.
# ==============================================================================

# --- APPLICATION SETTINGS ---
APP_NAME="GTA 6 AI Clip Factory"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- DATABASE (POSTGRESQL) ---
# Default to local PostgreSQL or fallback SQLite
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/gta6_clip_factory"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- TASK QUEUE & CACHE (REDIS) ---
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# --- HARDWARE & ACCELERATION ---
# "auto", "cuda", "cuda:0", "cpu"
DEVICE="auto"
CUDA_DEVICE_INDEX=0
MAX_GPU_MEMORY_MB=5120

# --- LOCAL FILE STORAGE PATHS ---
DATA_DIR="./data"
RECORDINGS_DIR="./data/recordings"
CLIPS_DIR="./data/clips"
THUMBNAILS_DIR="./data/thumbnails"
TEMP_DIR="./data/temp"
MAX_RECORDING_RETENTION_DAYS=7
MAX_STORAGE_QUOTA_GB=100

# --- FFMPEG & SYSTEM BINARIES ---
# Leave as "ffmpeg" if installed in system PATH, or specify exact binary path
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# --- SPEECH-TO-TEXT (FASTER-WHISPER) ---
# Models: "tiny", "base", "small", "medium"
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="auto"
WHISPER_COMPUTE_TYPE="float16"

# --- EXTERNAL API: YOUTUBE DATA API V3 ---
# Obtain from: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""
YOUTUBE_POLL_INTERVAL_SECONDS=120

# --- EXTERNAL API: YOUTUBE OAUTH 2.0 (OPTIONAL) ---
# Obtain from: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:8000/api/v1/auth/youtube/callback"

# --- EXTERNAL API: GOOGLE GEMINI (RECOMMENDED VLM) ---
# Obtain free API key from: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# --- EXTERNAL API: OPENAI (ALTERNATIVE VLM) ---
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- CLIP GENERATION CONFIGURATION ---
DEFAULT_CLIP_PRESET="Viral Gaming"
MIN_CLIP_DURATION_SECONDS=15
MAX_CLIP_DURATION_SECONDS=60
VERTICAL_RENDER_WIDTH=1080
VERTICAL_RENDER_HEIGHT=1920
VIDEO_BITRATE="6000k"
AUDIO_BITRATE="192k"
TARGET_FPS=30

# --- AUTOMATIC SOCIAL PUBLISHING SAFETY GUARD ---
# Strictly enforced by architecture: Automatic publishing is disabled.
ENABLE_AUTO_PUBLISH=false
